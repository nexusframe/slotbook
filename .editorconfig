root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Prefer modern C#
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Naming / correctness rules worth failing on
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait not needed in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage source-gen: overkill here
dotnet_diagnostic.IDE0055.severity = warning  # formatting
